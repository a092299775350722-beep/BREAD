---
import '../styles/global.css';
---

<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>確認訂單 - 姊姊的手作麵包坊</title>
  </head>
  <body class="bg-[#FDFBF7] text-gray-800 font-sans min-h-screen py-12 px-6">
    
    <div class="max-w-3xl mx-auto">
      <a href="/" class="text-amber-700 hover:text-amber-900 font-bold mb-6 inline-block">
        ← 返回繼續選購
      </a>

      <div class="bg-white p-8 md:p-10 rounded-2xl shadow-lg border border-amber-100">
        <h1 class="text-3xl font-extrabold text-amber-900 mb-8 border-b pb-4">填寫取貨資料</h1>
        
        <form id="checkoutForm" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">姓名</label>
              <input type="text" id="name" required class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition-all">
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">聯絡電話</label>
              <input type="tel" id="phone" required class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition-all">
            </div>
          </div>

          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">取貨方式</label>
            <select id="pickupMethod" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-amber-500 outline-none">
              <option value="工作室自取">工作室自取 (週末 14:00-18:00)</option>
              <option value="台中市區面交">台中市區面交 (西區/南區可約)</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">備註留言 (選填)</label>
            <textarea id="notes" rows="3" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-amber-500 outline-none" placeholder="有什麼想告訴我們的嗎？"></textarea>
          </div>

          <div class="bg-amber-50 p-6 rounded-xl mt-8">
            <h3 class="font-bold text-amber-900 mb-2">結帳金額確認</h3>
            <p class="text-sm text-gray-600 mb-4">明細將於下一步由系統自動載入</p>
          </div>

          <button type="submit" class="w-full bg-amber-600 text-white font-bold text-lg py-4 rounded-xl hover:bg-amber-700 transition-colors shadow-md mt-6">
            確認送出訂單
          </button>
        </form>
      </div>
    </div>

  </body>
</html>