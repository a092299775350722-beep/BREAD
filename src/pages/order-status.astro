---
import OrderStatusWidget from '../components/OrderStatusWidget.vue';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>訂單查詢 - 姊姊的手作麵包坊</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      body { background: #fef7e8; margin: 0; }
    </style>
  </head>
  <body class="min-h-screen flex flex-col">
    <Navbar />
    <main class="flex-1 max-w-2xl mx-auto w-full py-12 px-4">
      <OrderStatusWidget client:load />
    </main>
    <Footer />
  </body>
</html>