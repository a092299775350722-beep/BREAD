---
import '../styles/global.css';
// 1. 匯入我們剛剛做好的麵包卡片元件
import BreadCard from '../components/BreadCard.astro';
import CartWidget from '../components/CartWidget.vue';
import CartDrawer from '../components/CartDrawer.vue';
---

<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>姊姊的手作麵包坊</title>
  </head>
  <body class="bg-[#FDFBF7] text-gray-800 font-sans">
    
    <header class="bg-amber-100 py-24 text-center border-b border-amber-200">
      <h1 class="text-5xl font-extrabold text-amber-900 mb-4 tracking-widest">姊姊的手作麵包坊</h1>
      <p class="text-lg text-amber-700 font-medium">嚴選天然食材 ｜ 週末限定出爐</p>
    </header>

    <main class="max-w-6xl mx-auto px-6 py-16">
      <div class="mb-10">
        <h2 class="text-3xl font-bold text-gray-800 border-l-4 border-amber-600 pl-4">人氣推薦</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <BreadCard c
          title="海鹽奶油捲" 
          description="使用法國頂級發酵奶油，外酥內軟，帶有淡淡海鹽清香，是最經典的不敗口味。" 
          price="45" 
          icon="🥖" 
        />

        <BreadCard 
          title="酒釀桂圓歐包" 
          description="老麵發酵，搭配柴燒桂圓與核桃，口感紮實且香氣濃郁。" 
          price="120" 
          icon="🥐" 
        />

        <BreadCard 
          title="經典生吐司" 
          description="使用北海道鮮乳，連吐司邊都柔軟綿密，單吃就很美味。" 
          price="150" 
          icon="🍞" 
        />

      </div>
    </main>
    <CartWidget client:load />
    <CartDrawer client:load />
  </body>
</html>