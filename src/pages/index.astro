---
import '../styles/global.css';
import BreadCard from '../components/BreadCard.astro';
import CartWidget from '../components/CartWidget.vue';
import CartDrawer from '../components/CartDrawer.vue';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { products } from '../mock/products.js';
---

<html lang="zh-TW">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>春華製作所</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-[#FDFBF7] text-gray-800 font-sans">
    <Navbar />
    
    <main class="max-w-6xl mx-auto px-6 py-16">
      <div class="mb-10">
        <h2 class="text-3xl font-bold text-gray-800 border-l-4 border-amber-600 pl-4">人氣推薦</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
          <BreadCard 
            title={product.title}
            description={product.description}
            price={product.price}
            icon={product.icon}
          />
        ))}
      </div>
    </main>

    <Footer />
    <CartWidget client:load />
    <CartDrawer client:load />
  </body>
</html>