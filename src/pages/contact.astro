---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<html lang="zh-TW">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>聯絡我們 - 春華製作所</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      body { background: #fef7e8; }
    </style>
  </head>
  <body>
    <Navbar />
    <main class="max-w-4xl mx-auto px-6 py-16">
      <div class="bg-white rounded-3xl shadow-xl overflow-hidden">
        <div class="bg-amber-800 py-12 text-center">
          <div class="text-6xl mb-2">📞</div>
          <h1 class="text-4xl font-bold text-white">聯絡我們</h1>
          <div class="w-24 h-1 bg-amber-400 mx-auto mt-4 rounded-full"></div>
        </div>
        <div class="p-8">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h2 class="text-2xl font-bold text-stone-800 mb-4 border-l-4 border-amber-500 pl-3">營業資訊</h2>
              <ul class="space-y-4 text-gray-700">
                <li class="flex items-start gap-3"><span class="text-2xl">📞</span><div><span class="font-bold">電話</span><br>0912-345-678</div></li>
                <li class="flex items-start gap-3"><span class="text-2xl">✉️</span><div><span class="font-bold">Email</span><br>bread@example.com</div></li>
                <li class="flex items-start gap-3"><span class="text-2xl">📍</span><div><span class="font-bold">地址</span><br>台北市大安區復興南路一段123號1樓</div></li>
                <li class="flex items-start gap-3"><span class="text-2xl">⏰</span><div><span class="font-bold">營業時間</span><br>週五～週日 10:00-18:00（僅預購取貨）</div></li>
              </ul>
            </div>
            <div>
              <h2 class="text-2xl font-bold text-stone-800 mb-4 border-l-4 border-amber-500 pl-3">社群與其他</h2>
              <div class="bg-amber-50 rounded-2xl p-5 space-y-3">
                <p><span class="font-bold">📘 Facebook：</span> @sisterbread</p>
                <p><span class="font-bold">📷 Instagram：</span> @sisterbread</p>
                <p class="text-sm text-stone-600 mt-2">歡迎追蹤，獲取最新產品與不定期優惠活動～</p>
                <div class="border-t border-amber-200 pt-3 mt-2">
                  <p class="text-amber-800 text-sm">💡 訂單相關問題請直接私訊粉絲專頁，我們將於營業時間內回覆。</p>
                </div>
              </div>
            </div>
          </div>
          <!-- 簡易地圖佔位區（可以之後嵌入 Google Map） -->
          <div class="mt-8 bg-stone-100 rounded-2xl h-48 flex items-center justify-center text-stone-400">
            🗺️ [地圖佔位] 您可以在此處嵌入 Google 地圖
          </div>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>